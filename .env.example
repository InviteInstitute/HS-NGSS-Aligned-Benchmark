# Copy this file to `.env` and fill in your real key(s).
# Each model entry in config.yaml references one of these by name via `api_key_env`.
# The .env file is gitignored and must never be committed.

# This repo's config.yaml currently points every model at a University of
# Florida AI gateway (https://api.ai.it.ufl.edu/) via this variable name:
UF_fixed=your-key-here

# If you repoint config.yaml's base_url/api_key_env at a different provider,
# use (or add) a matching variable name here, e.g.:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# Local / self-hosted OpenAI-compatible servers often accept any non-empty token:
# LOCAL_KEY=not-needed
